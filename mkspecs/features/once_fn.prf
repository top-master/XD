
load(qtc_run_polyfill)

# TRACE/qmake improve: let `spec_pre.prf` know build directory's path #3-1,
# which's used here for clearing the right `QMAKE_SKIP_FILE` file,
# where the `.pro.user` extension ensures the file is ignored by Git/VCS.
defineTest(requireSkipFile) {
    # Maybe already done.
    !isEmpty(QMAKE_SKIP_FILE): return(true)
    # Maybe not supported.
    fake_pass: return(false)
    dir = $$props(OUT_PWD)
    isEmpty(dir): return(false)

    # Actual logic.
    QMAKE_SKIP_FILE = $$dir/.qmake.pro.user

    # Ensures not user edited.
    exists($$QMAKE_SKIP_FILE) {
        tmp = $$skipFileValue(Auto_Delete_This)
        !equals(tmp, yes) {
            win32: QMAKE_SKIP_FILE ~= s,/,\\,gi
            error("Auto-delete is disabled, manually remove file at:" $$QMAKE_SKIP_FILE)
        }
    }
    # Removes existing content.
    tmp = \
        $$LITERAL_HASH \
        "$$LITERAL_HASH WARNING: any change to this file will be lost in next QMake run." \
        $$LITERAL_HASH \
        "Auto_Delete_This = yes"
    write_file($$QMAKE_SKIP_FILE, tmp)
    export(QMAKE_SKIP_FILE)
    return(true)
}

# skipFileValue(name)
#
# Reads the variable <name> from `QMAKE_SKIP_FILE`. That file is this build's
# own record, not an input of the project; hence it stays out of the files the
# Makefile depends on. nmake can also read the empty rule of such a file
# (`.qmake.pro.user:`) as an inference rule, and stop.
defineReplace(skipFileValue) {
    value = $$fromfile($$QMAKE_SKIP_FILE, $$1)
    QMAKE_INTERNAL_INCLUDED_FILES -= $$QMAKE_SKIP_FILE
    export(QMAKE_INTERNAL_INCLUDED_FILES)
    return($$value)
}

#
# once(my_unique_key)
#
# Returns `true` only "once" for each key,
# which's possible because `spec_post.prf` runs only once-for-all QMake-passes,
# where `spec_post.prf` clears old `QMAKE_SKIP_FILE` file's entries.
#
defineTest(once) {
    qtc_run: return(false)
    requireSkipFile()|return(false)

    QMAKE_SKIP_LIST = $$skipFileValue(QMAKE_SKIP_LIST)
    !contains(QMAKE_SKIP_LIST, $$1) {
        line = "QMAKE_SKIP_LIST += $$1"
        write_file($$QMAKE_SKIP_FILE, line, append)
        QMAKE_SKIP_LIST += $$1
        export(QMAKE_SKIP_LIST)
        return(true)
    }
    return(false)
}
