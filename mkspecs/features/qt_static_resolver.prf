#
# WARNING: don't use `qt_static` before calling `load(qt_static_resolver)`, and
# that at least once per file's beginning, or, once per function.
#
# TRACE/mkspecs: added `qt_static` build-mode support #1,
# which needs adding macros here, see also:
shortcut {
    $$PWD/qt.prf
    $$PWD/qt_module.prf
    $$PWD/qt_functions.prf
    $$PWD/win32/windows.prf
}

force_bootstrap {
    CONFIG -= qt_static
}
qt_static {
    DEFINES += QT_STATIC
    # Note: forces static with export use
    # (i.e. an .exe can be used like a plugin).
    qt_force_export: DEFINES *= QT_FORCE_EXPORT
    export(DEFINES)

    MODULE_SUFFIX = _static
    MODULE_DIR = static/

    CONFIG(release, debug|release) {
        !contains(TEMPLATE, lib): CONFIG *= packing
    }
} else {
    # Shared-mode is the default, else would do:
    # ```
    # DEFINES += QT_SHARED
    # ```
    MODULE_SUFFIX =
    MODULE_DIR =
}

export(MODULE_SUFFIX)
export(MODULE_DIR)
export(CONFIG)

# Recursion-handler passed to the resolve_depends built-in (its 5th arg) by qt.prf.
#
# $$1 is the module qmake found in a dependency cycle,
# and $$2 is the list of deps that end up leading back to $$1.
#
# For qt_static builds, and only for `*_static` keyworded modules:
# static archives are allowed to reference each other
# (e.g. gui_static <-> platformsupport_static),
# and ld64 and/or link.exe resolve mutually-referential archives order-independently,
# so they're safe to keep -- the link needs them all present.
#
# For shared builds (not qt_static) this returns false, hence
# a real cycle still warns and drops as before.
#
defineTest(onQtModuleRecursion) {
    qt_static: contains(1, .*_static) {
        message("Ignored dependency cycle: $$1 caused by $$2")
        return(true)
    }
    return(false)
}
